+        def _m17_header_fallback(value: str, key: str) -> str:
+            try:
+                stripped = str(value or "").strip()
+                if not stripped or stripped == key:
+                    if key == "gateway.reset.header_new":
+                        return "🪄 新会话已创建。"
+                    return "🪄 新会话已开始。"
+                if stripped in {"新会话已开始。", "新会话已创建。"}:
+                    return f"🪄 {stripped}"
+                if stripped.startswith("🧭 新会话"):
+                    return f"🪄 {stripped.removeprefix('🧭').strip()}"
+            except Exception:
+                return value
+            return value
+
+        def _m17_format_reset_session_info(value: str) -> str:
+            try:
+                labels = {
+                    "Model": "🫪 模型",
+                    "Provider": "❤️ 服务商",
+                    "Context": "💭 上下文",
+                }
+                legacy_labels = {
+                    "🧠 模型：": "🫪 模型：",
+                    "🔌 服务商：": "❤️ 服务商：",
+                    "📚 上下文：": "💭 上下文：",
+                }
+                lines = []
+                for line in str(value).splitlines():
+                    normalized = line.strip()
+                    if normalized.startswith("◆ "):
+                        normalized = normalized[2:].strip()
+                    rendered = line
+                    for old_label, new_label in legacy_labels.items():
+                        if normalized.startswith(old_label):
+                            rendered = line.replace(old_label, new_label, 1)
+                            break
+                    if rendered != line:
+                        lines.append(rendered)
+                        continue
+                    for old_label, new_label in labels.items():
+                        prefix = f"{old_label}:"
+                        if normalized.startswith(prefix):
+                            rendered = f"{new_label}：{normalized[len(prefix):].strip()}"
+                            break
+                    lines.append(rendered)
+                return "\n".join(lines)
+            except Exception:
+                return value
+
+        def _m17_localize_reset_tip_body(value: str) -> str:
+            raw = str(value or "").strip()
+            if raw and re.search(r"[\u4e00-\u9fff]", raw):
+                return raw
+            commands = []
+            for match in re.findall(r"(?<!\w)/(?:[A-Za-z][A-Za-z0-9_-]*)(?:\b|$)", raw):
+                if match not in commands:
+                    commands.append(match)
+            if commands:
+                return f"可使用 {'、'.join(commands)} 继续操作。"
+            return "新会话已就绪，可以直接发送下一条消息。"
+
+        def _m17_format_reset_tip_line(value: str, raw_tip: str) -> str:
+            try:
+                stripped = str(value or "").strip()
+                lowered = stripped.lower()
+                english_tip = lowered.startswith(("tip:", "💡 tip:", "✦ tip:"))
+                if not stripped or stripped == "gateway.reset.tip" or english_tip:
+                    tip_source = raw_tip
+                    if english_tip:
+                        tip_source = re.sub(r"^(?:💡|✦)?\s*Tip:\s*", "", stripped, flags=re.IGNORECASE)
+                    return f"💫 提示：{_m17_localize_reset_tip_body(tip_source)}"
+                for legacy_prefix in ("✨ 提示：", "💡 提示："):
+                    if stripped.startswith(legacy_prefix):
+                        return f"💫 提示：{stripped.removeprefix(legacy_prefix)}"
+            except Exception:
+                return value
+            return value
